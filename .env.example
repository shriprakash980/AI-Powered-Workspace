# DevPilot AI — Environment Configuration Template

# Server & Runtime Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
FRONTEND_URL=http://localhost:5500

# Security (JWT)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Database Configuration (PostgreSQL — Phase 4)
DATABASE_URL=jdbc:postgresql://localhost:5432/devpilot
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres_dev_password

# AI Multi-Provider Configuration (Phase 8)
AI_DEFAULT_PROVIDER=OPENAI
AI_TIMEOUT_SECONDS=30
AI_FALLBACK_ENABLED=true

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# GitHub OAuth Integration (Phase 11)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/github/callback

# Sandbox Execution Limits (Phase 12)
EXECUTION_TIMEOUT_SECONDS=30
EXECUTION_MAX_MEMORY_MB=512
EXECUTION_CPU_QUOTA=1.0

# CI/CD Pipeline Configuration (Phase 13)
GITHUB_WEBHOOK_SECRET=devpilot_webhook_secret_key_123
CICD_ENABLED=true
CICD_MAX_CONCURRENT_RUNS=5
CICD_MAX_CONCURRENT_PER_PROJECT=2
CICD_QUEUE_SIZE=50
CICD_RUN_TIMEOUT_SECONDS=1800
